                            </div>
                          </TableCell>
                          <TableCell>
                            <Badge variant="secondary" className="font-medium text-xs md:text-sm">
                              {category.productCount} Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¬
                            </Badge>
                          </TableCell>
                          <TableCell>
                            {category.featured ? (
                              <Badge className="bg-gradient-to-r from-yellow-500 to-yellow-600 text-white border-0 shadow-md text-xs md:text-sm">
                                <Star className="w-2 h-2 md:w-3 md:h-3 mr-1" />
                                Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã…Â ÃƒËœÃ‚Â²ÃƒËœÃ‚Â©
                              </Badge>
                            ) : (
                              <Badge variant="outline" className="border-slate-300 text-xs md:text-sm">ÃƒËœÃ‚Â¹ÃƒËœÃ‚Â§ÃƒËœÃ‚Â¯Ãƒâ„¢Ã…Â ÃƒËœÃ‚Â©</Badge>
                            )}
                          </TableCell>
                          <TableCell>
                            <div className="flex gap-1 md:gap-2">
                              <Button
                                size="sm"
                                variant="outline"
                                onClick={() => handleEdit(category)}
                                className="bg-white hover:bg-primary/5 border-primary/20 text-primary shadow-md px-2 md:px-3 text-xs md:text-sm"
                              >
                                <Edit className="w-3 h-3 md:w-4 md:h-4 md:mr-2" />
                                <span className="hidden md:inline">ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¹ÃƒËœÃ‚Â¯Ãƒâ„¢Ã…Â Ãƒâ„¢Ã¢â‚¬Å¾</span>
                              </Button>
                              <Button
                                size="sm"
                                variant="outline"
                                onClick={() => handleDelete(category.id)}
                                className="bg-white hover:bg-red-50 border-red-200 text-red-700 shadow-md px-2 md:px-3 text-xs md:text-sm"
                              >
                                <Trash2 className="w-3 h-3 md:w-4 md:h-4" />
                              </Button>
                            </div>
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </div>
              </div>
            </div>
          ) : (
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {filteredCategories.map((category) => (
                <div key={category.id} className="group bg-white/80 backdrop-blur-xl border border-slate-200/50 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2 overflow-hidden">
                  <div className="relative">
                    {category.image ? (
                      <img
                        src={optimizeImage(category.image || '', { w: 640 })}
                        alt={category.nameAr}
                        className="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                        decoding="async"
                        srcSet={buildSrcSet(category.image || '', 640)}
                        sizes="(max-width: 1024px) 90vw, 640px"
                        onError={applyCategoryImageFallback}
                      />
                    ) : (
                      <div className="w-full h-48 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                        <Image className="w-16 h-16 text-slate-400" />
                      </div>
                    )}
                    {category.featured && (
                      <div className="absolute top-3 right-3 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                        <Star className="w-3 h-3 inline mr-1" />
                        Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã…Â ÃƒËœÃ‚Â²ÃƒËœÃ‚Â©
                      </div>
                    )}
                    <div className="absolute bottom-3 left-3">
                      <Badge className="bg-white/90 text-slate-700 border-0 shadow-md">
                        {category.productCount} Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¬
                      </Badge>
                    </div>
                  </div>
                  <div className="p-6">
                    <h3 className="font-bold text-lg text-slate-900 mb-2 group-hover:text-primary transition-colors">
                      {category.nameAr}
                    </h3>
                    <p className="text-sm text-slate-600 line-clamp-2 mb-4">
                      {category.descriptionAr || 'Ãƒâ„¢Ã¢â‚¬Å¾ÃƒËœÃ‚Â§ Ãƒâ„¢Ã…Â Ãƒâ„¢Ã‹â€ ÃƒËœÃ‚Â¬ÃƒËœÃ‚Â¯ Ãƒâ„¢Ã‹â€ ÃƒËœÃ‚ÂµÃƒâ„¢Ã‚Â'}
                    </p>
                    <div className="flex items-center justify-between pt-4 border-t border-slate-100">
                      <div className="flex gap-2">
                        <Button
                          size="sm"
                          variant="outline"
                          onClick={() => handleEdit(category)}
                          className="bg-white hover:bg-primary/5 border-primary/20 text-primary shadow-md"
                        >
                          <Edit className="w-4 h-4" />
                        </Button>
                        <Button
                          size="sm"
                          variant="outline"
                          onClick={() => handleDelete(category.id)}
                          className="bg-white hover:bg-red-50 border-red-200 text-red-700 shadow-md"
                        >
                          <Trash2 className="w-4 h-4" />
                        </Button>
                      </div>
                      <Badge variant="outline" className="text-xs border-slate-300">
                        {category.slug}
                      </Badge>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )
        )}

        <Dialog open={showForm} onOpenChange={setShowForm} modal={false}>
          <DialogContent
            className={isMobile
              ? 'max-w-[95vw] w-[95vw] max-h-[90vh] overflow-y-auto bg-gradient-to-br from-white/95 via-white/90 to-slate-50/95 backdrop-blur-3xl border border-slate-200/30 shadow-[0_32px_64px_-12px_rgba(0,0,0,0.25)] rounded-3xl'
              : 'max-w-4xl max-h-[95vh] overflow-y-auto bg-gradient-to-br from-white/95 via-white/90 to-slate-50/95 backdrop-blur-3xl border border-slate-200/30 shadow-[0_32px_64px_-12px_rgba(0,0,0,0.25)] rounded-3xl'}
            key={editingCategory ? String(editingCategory.id) : 'new'}
            onOpenAutoFocus={(e) => e.preventDefault()}
          >
            <DialogHeader className="border-b border-slate-200/30 pb-6">
              <DialogTitle className="text-3xl font-black bg-gradient-to-r from-primary via-purple-600 to-secondary bg-clip-text text-transparent flex items-center gap-3">
                <div className="w-12 h-12 bg-gradient-to-r from-primary via-purple-500 to-secondary rounded-2xl flex items-center justify-center shadow-xl">
                  {editingCategory ? <Edit className="w-6 h-6 text-white" /> : <Plus className="w-6 h-6 text-white" />}
                </div>
                {editingCategory ? 'ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¹ÃƒËœÃ‚Â¯Ãƒâ„¢Ã…Â Ãƒâ„¢Ã¢â‚¬Å¾ ÃƒËœÃ‚Â§Ãƒâ„¢Ã¢â‚¬Å¾Ãƒâ„¢Ã‚ÂÃƒËœÃ‚Â¦ÃƒËœÃ‚Â©' : 'ÃƒËœÃ‚Â¥ÃƒËœÃ‚Â¶ÃƒËœÃ‚Â§Ãƒâ„¢Ã‚ÂÃƒËœÃ‚Â© Ãƒâ„¢Ã‚ÂÃƒËœÃ‚Â¦ÃƒËœÃ‚Â© ÃƒËœÃ‚Â¬ÃƒËœÃ‚Â¯Ãƒâ„¢Ã…Â ÃƒËœÃ‚Â¯ÃƒËœÃ‚Â©'}
              </DialogTitle>
              <DialogDescription className="text-lg text-slate-600 font-medium mt-2 mr-15">
                {editingCategory ? 'ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¹ÃƒËœÃ‚Â¯Ãƒâ„¢Ã…Â Ãƒâ„¢Ã¢â‚¬Å¾ ÃƒËœÃ‚Â¨Ãƒâ„¢Ã…Â ÃƒËœÃ‚Â§Ãƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚Â§ÃƒËœÃ‚Âª ÃƒËœÃ‚Â§Ãƒâ„¢Ã¢â‚¬Å¾Ãƒâ„¢Ã‚ÂÃƒËœÃ‚Â¦ÃƒËœÃ‚Â© ÃƒËœÃ‚Â§Ãƒâ„¢Ã¢â‚¬Å¾Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚Â­ÃƒËœÃ‚Â¯ÃƒËœÃ‚Â¯ÃƒËœÃ‚Â©' : 'ÃƒËœÃ‚Â¥ÃƒËœÃ‚Â¶ÃƒËœÃ‚Â§Ãƒâ„¢Ã‚ÂÃƒËœÃ‚Â© Ãƒâ„¢Ã‚ÂÃƒËœÃ‚Â¦ÃƒËœÃ‚Â© ÃƒËœÃ‚Â¬ÃƒËœÃ‚Â¯Ãƒâ„¢Ã…Â ÃƒËœÃ‚Â¯ÃƒËœÃ‚Â© Ãƒâ„¢Ã¢â‚¬Å¾ÃƒËœÃ‚ÂªÃƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚Â¸Ãƒâ„¢Ã…Â Ãƒâ„¢Ã¢â‚¬Â¦ ÃƒËœÃ‚Â§Ãƒâ„¢Ã¢â‚¬Å¾Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¬ÃƒËœÃ‚Â§ÃƒËœÃ‚Âª'}
              </DialogDescription>
            </DialogHeader>

            <CategoryForm
              formData={formData}
              setFormData={setFormData}
              editingCategory={editingCategory}
              handleSubmit={handleSubmit}
              loading={loading}
              resetForm={resetForm}
              handleInputChange={handleInputChange}
              handleImageChange={handleImageChange}
              generateSlug={generateSlug}
              categoriesList={categoriesList}
              availableProducts={availableProducts}
              categoryProducts={categoryProducts}
              productsLoading={productsLoading}
              inlineProductSearch={inlineProductSearch}
              setInlineProductSearch={setInlineProductSearch}
              handleProductToggle={handleProductToggle}
            />
          </DialogContent>
        </Dialog>

      </div>
    </AdminLayout>
  );
};

// Ultra-Modern Category Form Component with glassmorphism effects
interface CategoryFormProps {
  formData: CategoryFormData;
  setFormData: React.Dispatch<React.SetStateAction<CategoryFormData>>;
  editingCategory: Category | null;
  handleSubmit: (e: React.FormEvent) => Promise<void>;
  loading: boolean;
  resetForm: () => void;
  handleInputChange: (field: keyof CategoryFormData, value: string | boolean | string[]) => void;
  handleImageChange: (images: string[]) => void;
  generateSlug: (name: string) => string;
  categoriesList: Category[];
  availableProducts: Product[];
  categoryProducts: Product[];
  productsLoading: boolean;
  inlineProductSearch: string;
  setInlineProductSearch: (search: string) => void;
  handleProductToggle: (productId: string) => void;
}

const CategoryForm = memo(function CategoryForm({
  formData,
  setFormData,
  editingCategory,
  handleSubmit,
  loading,
  resetForm,
  handleInputChange,
  handleImageChange,
  generateSlug,
  availableProducts,
  categoryProducts,
  productsLoading,
  inlineProductSearch,
  setInlineProductSearch,
  handleProductToggle
}: CategoryFormProps) {

  const [orderSearch, setOrderSearch] = useState('');
  const [orderDrafts, setOrderDrafts] = useState<Record<string, string>>({});
  const { familyCardsInListings } = usePricingSettings();
  const [storefrontFamilies, setStorefrontFamilies] = useState<StorefrontProductFamily[]>([]);

  useEffect(() => {
    let mounted = true;
    if (!familyCardsInListings) {
      setStorefrontFamilies([]);
      return;
    }
    (async () => {
      try {
        const allFamilies = await fetchStorefrontProductFamilies();
        if (!mounted) return;
        const categorySet = new Set((categoryProducts || []).map((p) => String(p._id)));
        const filteredFamilies = allFamilies.filter((f) =>
          (f.variants || []).some((v) => categorySet.has(String(v.productId)))
        );
        setStorefrontFamilies(filteredFamilies);
      } catch {
        if (mounted) setStorefrontFamilies([]);
      }
    })();
    return () => {
      mounted = false;
    };
  }, [familyCardsInListings, categoryProducts]);

  const productToFamilyId = useMemo(() => {
    const map = new Map<string, string>();
    for (const fam of storefrontFamilies || []) {
      for (const v of fam.variants || []) {
        map.set(String(v.productId), String(fam.id));
      }
    }
    return map;
  }, [storefrontFamilies]);

  type OrderRow = {
    key: string;
    type: 'family' | 'product';
    representativeId: string;
    title: string;
    subtitle: string;
    image?: string;
  };

  const orderRows = useMemo<OrderRow[]>(() => {
    const list = [...(categoryProducts || [])].sort((a, b) =>
      String(a.nameAr || a.name || '').localeCompare(String(b.nameAr || b.name || ''), 'ar')
    );
    if (!familyCardsInListings) {
      return list.map((p) => ({
        key: `product:${String(p._id)}`,
        type: 'product',
        representativeId: String(p._id),
        title: String(p.nameAr || p.name || 'Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¬'),
        subtitle: p.sku ? `SKU: ${p.sku}` : 'Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¬ Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â Ãƒâ„¢Ã‚ÂÃƒËœÃ‚Â±ÃƒËœÃ‚Â¯',
        image: p.image,
      }));
    }

    const byId = new Map(list.map((p) => [String(p._id), p] as const));
    const familyDone = new Set<string>();
    const rows: OrderRow[] = [];
    for (const p of list) {
      const pid = String(p._id);
      const familyId = productToFamilyId.get(pid);
      if (!familyId) {
        rows.push({
          key: `product:${pid}`,
          type: 'product',
          representativeId: pid,
          title: String(p.nameAr || p.name || 'Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¬'),
          subtitle: p.sku ? `SKU: ${p.sku}` : 'Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¬ Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â Ãƒâ„¢Ã‚ÂÃƒËœÃ‚Â±ÃƒËœÃ‚Â¯',
          image: p.image,
        });
        continue;
      }
      if (familyDone.has(familyId)) continue;
      familyDone.add(familyId);
      const fam = storefrontFamilies.find((f) => String(f.id) === familyId);
      if (!fam) continue;
      const categoryMembers = (fam.variants || []).filter((v) => byId.has(String(v.productId)));
      if (!categoryMembers.length) continue;
      const defaultInCategory = categoryMembers.find((v) => String(v.productId) === String(fam.defaultProductId));
      const representativeId = String((defaultInCategory || categoryMembers[0]).productId);
      const representative = byId.get(representativeId);
      rows.push({
        key: `family:${familyId}`,
        type: 'family',
        representativeId,
        title: String(fam.nameAr || fam.name || representative?.nameAr || representative?.name || 'ÃƒËœÃ‚Â¹ÃƒËœÃ‚Â§ÃƒËœÃ‚Â¦Ãƒâ„¢Ã¢â‚¬Å¾ÃƒËœÃ‚Â©'),
        subtitle: `ÃƒËœÃ‚Â¨ÃƒËœÃ‚Â·ÃƒËœÃ‚Â§Ãƒâ„¢Ã¢â‚¬Å¡ÃƒËœÃ‚Â© ÃƒËœÃ‚Â¹ÃƒËœÃ‚Â§ÃƒËœÃ‚Â¦Ãƒâ„¢Ã¢â‚¬Å¾ÃƒËœÃ‚Â© ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢ ${categoryMembers.length} Ãƒâ„¢Ã¢â‚¬Â¦Ãƒâ„¢Ã¢â‚¬Â ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¬`,
        image: representative?.image || categoryMembers[0]?.image,
      });
    }
    return rows;
  }, [categoryProducts, familyCardsInListings, productToFamilyId, storefrontFamilies]);

  const rowByKey = useMemo(() => new Map(orderRows.map((r) => [r.key, r] as const)), [orderRows]);

  const rowKeyForProductId = useCallback((productId: string) => {
    if (!familyCardsInListings) return `product:${String(productId)}`;
    const familyId = productToFamilyId.get(String(productId));
    return familyId ? `family:${familyId}` : `product:${String(productId)}`;
  }, [familyCardsInListings, productToFamilyId]);

  const orderedRowKeys = useMemo(() => {
    const seen = new Set<string>();
    const out: string[] = [];
    for (const pid of formData.productDisplayOrder || []) {
      const key = rowKeyForProductId(String(pid));
      if (seen.has(key) || !rowByKey.has(key)) continue;
      seen.add(key);
      out.push(key);
    }
    for (const row of orderRows) {
      if (seen.has(row.key)) continue;
      seen.add(row.key);
      out.push(row.key);
    }
    return out;
  }, [formData.productDisplayOrder, rowKeyForProductId, rowByKey, orderRows]);

  const orderedRowsForDisplay = useMemo(
    () => orderedRowKeys.map((k) => rowByKey.get(k)).filter((r): r is OrderRow => !!r),
    [orderedRowKeys, rowByKey]
  );

  const orderRowsFiltered = useMemo(() => {
    const q = orderSearch.trim().toLowerCase();
    return orderedRowsForDisplay.filter((r) => {
      const matchesSearch = !q
        || r.title.toLowerCase().includes(q)
        || r.subtitle.toLowerCase().includes(q);
      return matchesSearch;
    });
  }, [orderedRowsForDisplay, orderSearch]);

  const setOrderedRows = (keys: string[]) => {
    const seen = new Set<string>();
    const normalized: string[] = [];
    for (const k of keys) {
      if (!rowByKey.has(k) || seen.has(k)) continue;
      seen.add(k);
      normalized.push(k);
    }
    for (const row of orderRows) {
      if (seen.has(row.key)) continue;
      seen.add(row.key);
      normalized.push(row.key);
    }
    const nextProductIds = normalized
      .map((k) => rowByKey.get(k)?.representativeId || '')
      .filter(Boolean);
    setFormData((prev) => ({ ...prev, productDisplayOrder: nextProductIds }));
  };

  const moveOrderItem = (rowKey: string, direction: -1 | 1) => {
    const current = [...orderedRowKeys];
    const idx = current.indexOf(rowKey);
    if (idx < 0) return;
    const nextIdx = idx + direction;
    if (nextIdx < 0 || nextIdx >= current.length) return;
    const swap = current[nextIdx];
    current[nextIdx] = current[idx];
    current[idx] = swap;
    setOrderedRows(current);
  };

  const moveOrderItemToPosition = (rowKey: string, positionOneBased: number) => {
    const current = [...orderedRowKeys];
    const idx = current.indexOf(rowKey);
    if (idx < 0 || current.length === 0) return;
    const clamped = Math.max(1, Math.min(current.length, Math.round(positionOneBased || 1)));
    const nextIdx = clamped - 1;
    if (idx === nextIdx) return;
    current.splice(idx, 1);
    current.splice(nextIdx, 0, rowKey);
    setOrderedRows(current);
  };

  const applyInlineOrder = (rowKey: string, fallbackPosition: number) => {
    const raw = (orderDrafts[rowKey] ?? String(fallbackPosition)).trim();
    const parsed = Number(raw);
    if (Number.isFinite(parsed)) moveOrderItemToPosition(rowKey, parsed);
    setOrderDrafts((prev) => {
      const next = { ...prev };
      delete next[rowKey];
      return next;
    });
  };

  return (
    <form onSubmit={handleSubmit} className="flex flex-col gap-0">

      {/* ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ Two-column body ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ */}
      <div className="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-6 p-6">

        {/* LEFT: text fields */}
